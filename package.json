{
  "name": "cybercup",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"RP-SERVER,FRONTEND\" -c \"cyan,magenta\" \"tsx watch server/server.ts\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/server.ts",
    "server": "tsx watch server/server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-svelte": "^1.0.1",
    "tsx": "^4.23.15"
  }
}
